{
  "name": "@ogza/shared-infra",
  "version": "1.0.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./web": {
      "import": "./dist/web-client.mjs",
      "require": "./dist/web-client.js",
      "types": "./dist/web-client.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/web-client.ts --format cjs,esm --dts --clean",
    "dev": "tsc --watch",
    "test": "vitest run --coverage",
    "test:watch": "vitest watch",
    "test:ui": "vitest --ui",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@ogza/core": "git+https://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@github.com/OgzaTech/ogza-lib-typescript-core.git#v0.0.1",
    "axios": "^1.6.0",
    "bcrypt": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^7.0.12",
    "telegraf": "^4.16.3",
    "twilio": "^5.0.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.0.0",
    "@types/nodemailer": "^7.0.4",
    "@vitest/coverage-v8": "^4.0.14",
    "@vitest/ui": "^4.0.14",
    "tsup": "^8.5.1",
    "typescript": "^5.0.0",
    "vitest": "^4.0.14"
  }
}
